# The patterns above are unanchored, so they swallow sources as well as build
# output — `!src/tileserver/tile-sw.js` above is the same problem, patched once
# before. The whole test suite was invisible to git because of it.
!test/**
dist/*.d.ts
dist/
dist/

# 適合テストが吐く自分の出力。突き合わせ用の中間物で、正本は projection-expected.txt。
test/resources/projection-actual.*.txt
